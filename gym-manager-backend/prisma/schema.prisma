// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Gym {
  id        Int      @id @default(autoincrement())
  name      String

  street    String
  city      String
  province  String
  country   String   @default("Argentina")

  phone     String
  email     String

  // Fecha hasta la cual el gimnasio puede ESCRIBIR en el sistema (días de uso).
  accessUntil DateTime?

  createdAt DateTime @default(now())

  users     User[]
  members   Member[]
  plans     Plan[]
  exercises Exercise[]
  routines  Routine[]
  subscriptions Subscription[]

  @@index([name])
  @@index([city])
  @@index([province])
}

model User {
  id        Int      @id @default(autoincrement())
  gymId     Int?
  email     String   @unique
  createdAt DateTime @default(now())
  role         UserRole @default(STAFF)

  gym      Gym?       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  password Password?
  passwordResetTokens PasswordResetToken[]

  @@index([gymId])
}

model Password {
  id     Int    @id @default(autoincrement())
  hash   String
  userId Int    @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model Member {
  id        Int      @id @default(autoincrement())
  gymId     Int
  firstName String
  lastName  String
  dni       String
  phone     String?
  email     String?
  joinDate  DateTime @default(now())
  active    Boolean  @default(true)

  gym         Gym            @relation(fields: [gymId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  routines    MemberRoutine[]

  @@unique([gymId, dni])
  @@index([gymId, lastName])
}

model Plan {
  id           Int      @id @default(autoincrement())
  gymId        Int
  name         String
  price        Decimal  @db.Decimal(10, 2)
  durationDays Int
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())


  gym         Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]

  @@index([gymId])
}

model Enrollment {
  id        Int               @id @default(autoincrement())
  memberId  Int
  planId    Int
  startDate DateTime
  endDate   DateTime
  status    EnrollmentStatus  @default(ACTIVE)
  createdAt DateTime          @default(now())

  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  plan     Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([memberId])
  @@index([planId])
  @@index([endDate])
}

model Payment {
  id           Int      @id @default(autoincrement())
  enrollmentId Int
  amount       Decimal  @db.Decimal(10, 2)
  paidAt       DateTime @default(now())

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([paidAt])
}


model Exercise {
  id          Int      @id @default(autoincrement())
  gymId       Int
  name        String
  createdAt   DateTime @default(now())

  gym      Gym              @relation(fields: [gymId], references: [id], onDelete: Cascade)
  routines RoutineExercise[]

  @@index([gymId])
}

model Routine {
  id        Int      @id @default(autoincrement())
  gymId     Int
  name      String
  notes     String?
  createdAt DateTime @default(now())

  gym       Gym              @relation(fields: [gymId], references: [id], onDelete: Cascade)
  exercises RoutineExercise[]
  members   MemberRoutine[]

  @@index([gymId])
}

model RoutineExercise {
  id         Int @id @default(autoincrement())
  routineId  Int
  exerciseId Int
  sets       Int?
  reps       Int?
  weight     String?
  orderIndex Int?

  routine  Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([routineId])
  @@index([exerciseId])
}

model MemberRoutine {
  id         Int      @id @default(autoincrement())
  memberId   Int
  routineId  Int
  assignedAt DateTime @default(now())

  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  routine Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([routineId])
}

enum EnrollmentStatus {
  ACTIVE
  EXPIRED
  CANCELED
}

enum UserRole {
  ADMIN
  STAFF
}

model SubscriptionPlan {
  id        Int      @id @default(autoincrement())
  name      String
  days      Int
  price     Decimal  @db.Decimal(10, 2)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  subscriptions Subscription[]
}

model Subscription {
  id                 Int                @id @default(autoincrement())
  gymId              Int
  planId             Int?
  status             SubscriptionStatus @default(PENDING)
  startDate          DateTime?
  endDate            DateTime?
  amount             Decimal            @db.Decimal(10, 2)
  mercadoPagoPaymentId String?
  externalReference  String?            @unique
  paidAt             DateTime?
  createdAt          DateTime           @default(now())

  gym  Gym              @relation(fields: [gymId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([gymId])
  @@index([status])
  @@index([externalReference])
}

enum SubscriptionStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}
